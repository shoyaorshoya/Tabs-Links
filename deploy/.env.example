# ── AI labels + short descriptions (optional) ───────────────────────
# Without a key, ClosedTabs still saves links, titles, descriptions and
# page text, and search works. Labels need the key.
#
# Get a key at https://platform.claude.com (API keys), paste it after the =,
# then run the start script again.
ANTHROPIC_API_KEY=

# Which Claude model writes the labels.
# Default: claude-opus-5-5 (best quality, about €0.01–0.02 per link).
# Cheaper alternative: claude-haiku-5-5 (about 40x cheaper per token).
CLAUDE_MODEL=claude-opus-5-5
