# ── Core ─────────────────────────────────────────────────────────────
# Pin a version once things work (see ghcr.io/karakeep-app/karakeep for tags)
KARAKEEP_VERSION=release
# Generate each with:  openssl rand -base64 36
NEXTAUTH_SECRET=change_me
MEILI_MASTER_KEY=change_me
# Your public address (https://links.yourdomain.com) once hosted
NEXTAUTH_URL=http://localhost:3000
# After creating your own account, set to true and restart
DISABLE_SIGNUPS=false

# ── AI: Claude via Anthropic's OpenAI-compatible endpoint ───────────
# Key from https://platform.claude.com (API keys). Keep it secret.
OPENAI_BASE_URL=https://api.anthropic.com/v1/
OPENAI_API_KEY=sk-ant-change_me
# A fast, inexpensive model is enough for tagging and summaries
INFERENCE_TEXT_MODEL=claude-haiku-5-5
INFERENCE_IMAGE_MODEL=claude-haiku-5-5
# If tags come back malformed, try "plain"
INFERENCE_OUTPUT_SCHEMA=json
INFERENCE_ENABLE_AUTO_TAGGING=true
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
INFERENCE_LANG=english

# Claude has no embeddings model -> keep semantic search off
# (full-text search via Meilisearch still works)...
EMBEDDING_ENABLE_AUTO_INDEXING=false
SEMANTIC_SEARCH_ENABLED=false
# ...or use a separate embeddings provider:
# EMBEDDING_ENABLE_AUTO_INDEXING=true
# SEMANTIC_SEARCH_ENABLED=true
# EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_OPENAI_API_KEY=sk-...
# EMBEDDING_TEXT_MODEL=text-embedding-3-small

# ── Crawling / archiving ────────────────────────────────────────────
CRAWLER_STORE_SCREENSHOT=true
# Full local page copies use much more disk; enable if link-rot worries you
CRAWLER_FULL_PAGE_ARCHIVE=false
